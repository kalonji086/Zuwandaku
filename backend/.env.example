# Backend .env for Railway/Production
# Required
DATABASE_URL=postgresql://user:pass@host:port/db?schema=public
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
FRONTEND_URL=https://your-frontend.vercel.app  # Your frontend deploy URL
PORT=3000  # Railway auto-sets

# Optional - Mail (for OTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=app-password

# Supabase (if used)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# CORS: Add your frontend domains to FRONTEND_URL (comma-separated if multiple)
