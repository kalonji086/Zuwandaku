{
  "name": "zuwandaku-backend",
  "version": "0.1.0",
  "description": "ZUWAndaku Backend - NestJS API",
  "main": "dist/main.js",
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "node prisma/seed.js"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write src/**/*.ts",
    "start": "nest start",
    "start:dev": "nest start --watch",
