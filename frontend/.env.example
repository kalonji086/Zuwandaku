# ==========================================
# Zuwandaku Frontend - Environment Variables
# Copy this file to .env.local for local dev
# Set these in Netlify Dashboard → Site Settings → Environment Variables
# ==========================================

# Backend API URL (must be public for client-side requests)
NEXT_PUBLIC_API_URL=https://zuwandaku-backend.fly.dev/api

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-anon-key

# Note: Do NOT commit .env.local or real keys to Git!

